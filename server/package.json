{
  "name": "kynov-ai-server",
  "version": "1.0.0",
  "private": true,
  "description": "KYNOV AI backend \u2014 Express + TypeScript REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=2048 tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=2048 tsc -p tsconfig.json --noEmit",
    "test": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.7",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^10.1.3",
    "pdfkit": "^0.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}