# ─────────────────────────────────────────────────────────────
# KYNOV AI — environment template.  Copy to server/.env
#   cp .env.example server/.env
# Every value below is a PLACEHOLDER. The app boots without
# external services and shows a precise setup message for any
# integration that is not configured. No fake data is served.
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────
# Paste your MongoDB Atlas SRV string here. Leave empty to run the
# bundled ephemeral MongoDB (development only, data is NOT persisted).
MONGODB_URI=
# Optional: name of an Atlas Vector Search index on filechunks.embedding.
# When empty, KYNOV falls back to an in-process cosine ranking (real
# vector math, just not index-accelerated).
MONGODB_VECTOR_INDEX=kynov_vector_index
MONGODB_DB=kynov

# ── Auth / session ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Google OAuth 2.0 / Gmail API ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/oauth/callback
# Frontend URL the OAuth callback redirects back to
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/gmail

# ── File storage ──────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
MAX_FILE_SIZE_MB=25

# Amazon S3 (used when STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional custom endpoint (MinIO / R2 / Backblaze S3)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── AI provider (OpenAI-compatible: OpenAI, Azure OpenAI, Groq, Ollama, OpenRouter…) ──
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1100
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=6

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
AUTH_RATE_LIMIT_MAX=20
